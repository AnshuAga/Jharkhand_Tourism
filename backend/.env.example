# ============================================================
# Jharkhand Smart Tourism Platform - Environment Variables Template
# ============================================================

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (SQLite file path or PostgreSQL connection URL)
DATABASE_URL=
SQLITE_DB_PATH=./src/database/jharkhand_tourism.db

# Review moderation policy
# false/blank keeps new reviews pending administrator publication approval.
# Set true only when low-risk reviews should be published automatically.
REVIEWS_AUTO_PUBLISH=false
REVIEWS_MEDIUM_RISK_ACTION=hold
FAKE_REVIEW_MEDIUM_RISK_THRESHOLD=0.35
FAKE_REVIEW_HIGH_RISK_THRESHOLD=0.65

# JWT Authentication Secrets
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Real Email Service (SMTP / Nodemailer) for Email OTP Verification
# Provide your actual SMTP credentials (e.g., Gmail, SendGrid, AWS SES)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Jharkhand Tourism" <no-reply@jharkhandtourism.gov.in>

# Payment Gateway (Razorpay or Stripe)
# Razorpay Credentials (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe Alternative (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI & LLM Service (Google Gemini or OpenAI)
# Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# OpenAI Alternative
OPENAI_API_KEY=

# Blockchain Network & Smart Contract (Polygon Amoy / Sepolia Testnet)
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=0x35935098b5888b3ce57259d7cd7e01e92556bcd3

# Map & Geolocation API (Optional - defaults to OpenStreetMap / OSRM)
GOOGLE_MAPS_API_KEY=

# Weather API (Optional - defaults to Open-Meteo)
WEATHER_API_KEY=

# Optional authorized train search adapter. Empty means live train data is unavailable.
TRAIN_SEARCH_API_URL=
TRAIN_SEARCH_API_KEY=

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
